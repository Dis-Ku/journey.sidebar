{
  "manifest_version": 3,
  "name": "Journey Sidebar",
  "version": "4.0.0",
  "description": "ブラウザのサイドパネルに簡易日記エディタを表示し、Journeyの投稿用メールアドレス宛にエントリーを送信します。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Journey Sidebar を開く/閉じる",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": ["sidePanel", "storage"]
}
