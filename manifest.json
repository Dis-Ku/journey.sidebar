{
  "manifest_version": 3,
  "name": "Journey Sidebar",
  "version": "1.0.0",
  "description": "Edgeサイドバー廃止の代替。ブラウザのサイドパネルにオンライン日記アプリ Journey を表示します。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Journey Sidebar を開く/閉じる",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "sidePanel",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.journey.cloud/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "journey_ruleset",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
